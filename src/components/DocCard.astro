---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const { title, description, href, icon } = Astro.props;
---

<a
  href={href}
  class="group block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm hover:shadow-md hover:border-primary-300 dark:hover:border-primary-700 transition-all"
>
  {icon && (
    <div class="mb-3 text-3xl">
      <span>{icon}</span>
    </div>
  )}
  <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
    {title}
  </h3>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
    {description}
  </p>
</a>
