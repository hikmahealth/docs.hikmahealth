---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { navigation } from "../../data/navigation";

export async function getStaticPaths() {
    const docs = await getCollection("docs");
    return docs.map((doc: CollectionEntry<"docs">) => ({
        params: { slug: doc.id },
        props: { doc },
    }));
}

type Props = { doc: CollectionEntry<"docs"> };

const { doc } = Astro.props as Props;
const { Content, headings } = await render(doc);

// Find the section name from navigation data
const currentPath = `/docs/${doc.id}`;
let sectionName: string | undefined;
for (const section of navigation) {
    if (section.items.some((item) => item.href === currentPath)) {
        sectionName = section.emoji
            ? `${section.emoji} ${section.title}`
            : section.title;
        break;
    }
}
---

<DocsLayout
    title={doc.data.title}
    description={doc.data.description}
    section={sectionName}
    headings={headings}
>
    <Content />
</DocsLayout>
