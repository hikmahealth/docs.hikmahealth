---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { navigation } from "../../../data/navigation";
import { videos } from "../../../data/videos-playlist";

const section = navigation.find((navSection) =>
  navSection.items.some((item) => item.href === "/docs/media/videos"),
);
const sectionName = section
  ? section.emoji
    ? `${section.emoji} ${section.title}`
    : section.title
  : undefined;
---

<DocsLayout
  title="Videos & Playlists"
  description="Recorded walkthroughs of Hikma Health — pick a video from the list to play it."
  section={sectionName}
  headings={[]}
  prose={false}
>
  <div
    id="video-stage"
    class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-black aspect-video"
  >
    <iframe
      id="video-player"
      src={videos[0].embed}
      title={videos[0].title}
      class="w-full h-full"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"></iframe>
  </div>

  {
    videos.map((video, index) => (
      <div data-video-detail={video.id} hidden={index !== 0} class="mt-6">
        <h2 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">
          {video.title}
        </h2>
        <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-400">
          {video.description}
        </p>
        {video.actions && video.actions.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            {video.actions.map((action) => (
              <a
                href={action.link}
                class="text-sm text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 underline underline-offset-2"
              >
                {action.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))
  }

  <h2
    class="mt-10 mb-4 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"
  >
    All videos
  </h2>

  <div class="space-y-2">
    {
      videos.map((video, index) => (
        <button
          type="button"
          class="video-list-item w-full text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 transition-colors hover:border-primary-300 dark:hover:border-primary-700 hover:bg-gray-50 dark:hover:bg-gray-800"
          data-video-id={video.id}
          data-video-embed={video.embed}
          aria-current={index === 0 ? "true" : "false"}
        >
          <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100">
            {video.title}
          </span>
          <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">
            {video.description}
          </span>
        </button>
      ))
    }
  </div>
</DocsLayout>

<style>
  .video-list-item[aria-current="true"] {
    border-color: #4d6cd2;
    background: #eef1fb;
  }
  :global(html.dark) .video-list-item[aria-current="true"] {
    border-color: #2f51b3;
    background: rgba(47, 81, 179, 0.12);
  }
</style>

<script>
  function initVideoPlaylist() {
    const player = document.getElementById("video-player") as HTMLIFrameElement | null;
    const stage = document.getElementById("video-stage");
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-video-id]");
    const details = document.querySelectorAll<HTMLElement>("[data-video-detail]");
    if (!player || buttons.length === 0) return;

    function show(selected: HTMLButtonElement, autoplay: boolean) {
      const embed = selected.dataset.videoEmbed;
      const id = selected.dataset.videoId;
      if (!embed || !id || !player) return;

      // Autoplay is only requested on click; browsers block it on page load.
      player.src = autoplay
        ? `${embed}${embed.includes("?") ? "&" : "?"}autoplay=1`
        : embed;
      buttons.forEach((button) =>
        button.setAttribute("aria-current", button === selected ? "true" : "false"),
      );
      details.forEach((detail) => {
        detail.hidden = detail.dataset.videoDetail !== id;
      });

      const url = new URL(window.location.href);
      url.searchParams.set("video", id);
      window.history.replaceState(null, "", url);
    }

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        show(button, true);
        stage?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }),
    );

    // A ?video= id that no longer exists just leaves the first video selected.
    const requested = new URL(window.location.href).searchParams.get("video");
    const deepLinked = Array.from(buttons).find(
      (button) => button.dataset.videoId === requested,
    );
    if (deepLinked) show(deepLinked, false);
  }

  initVideoPlaylist();

  document.addEventListener("astro:after-swap", initVideoPlaylist);
</script>
