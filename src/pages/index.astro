---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import DocCard from "../components/DocCard.astro";
import HikmaHeroStream from "../components/HikmaHeroStream.tsx";
import ImpactStats from "../components/ImpactStats.tsx";
import PlatformPillars from "../components/PlatformPillars.tsx";
import PlatformOverview from "../components/PlatformOverview.tsx";
import { navigation } from "../data/navigation";
---

<Layout
    title="Hikma Health Docs"
    description="Documentation for the Hikma Health open source electronic health record platform."
>
    <Header />

    <!-- Mobile navigation overlay -->
    <div
        id="mobile-sidebar-overlay"
        class="fixed inset-0 z-40 bg-black/50 hidden lg:hidden"
        aria-hidden="true"
    >
        <div
            class="w-72 h-full bg-white dark:bg-gray-950 overflow-y-auto border-r border-gray-200 dark:border-gray-800"
        >
            <div
                class="flex items-center justify-between px-4 py-4 border-b border-gray-200 dark:border-gray-800"
            >
                <span
                    class="text-sm font-semibold text-gray-900 dark:text-gray-100"
                    >Navigation</span
                >
                <button
                    id="mobile-sidebar-close"
                    class="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                    aria-label="Close navigation"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="py-6 px-4">
                <ul class="space-y-6">
                    {
                        navigation.map((navSection) => (
                            <li>
                                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 px-3 mb-1">
                                    {navSection.emoji && (
                                        <span class="mr-1">
                                            {navSection.emoji}
                                        </span>
                                    )}
                                    {navSection.title}
                                </h3>
                                <ul class="mt-1 space-y-0.5 border-l border-gray-200 dark:border-gray-700 ml-3">
                                    {navSection.items.map((item) => (
                                        <li>
                                            <a
                                                href={item.href}
                                                class="block pl-4 py-1.5 text-sm transition-colors border-l-2 -ml-px border-transparent text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-600"
                                            >
                                                {item.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>

    <main class="min-h-[calc(100vh-4rem)]">
        <!-- Hero -->
        <section
            class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-hikma-50 via-white to-primary-50 dark:from-hikma-950/30 dark:via-gray-950 dark:to-primary-950/30"
            >
            </div>
            <div
                class="relative max-w-4xl mx-auto px-6 py-20 sm:py-28 text-center"
            >
                <div
                    class="inline-flex items-center gap-2 rounded-full bg-hikma-100 dark:bg-hikma-900/40 px-4 py-1.5 text-sm font-medium text-hikma-700 dark:text-hikma-300 mb-6"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-hikma-500 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-hikma-500"
                        ></span>
                    </span>
                    Open Source
                </div>
                <h1
                    class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight"
                >
                    The first free mobile health data system for physicians
                    serving refugees.
                </h1>
                <p
                    class="mt-6 text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed"
                >
                    Complete ecosystem of open source tooling for health
                    facilities, organizations and providers to deliver care
                    reliably.
                </p>

                <div class="mt-10 w-full max-w-3xl mx-auto">
                    <HikmaHeroStream client:load />
                </div>

                <div
                    class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4"
                >
                    <a
                        href="/docs/introduction/getting-started"
                        class="inline-flex items-center gap-2 rounded-lg bg-hikma-600 hover:bg-hikma-700 px-6 py-3 text-base font-medium text-white shadow-sm transition-colors"
                    >
                        Get started
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a
                        href="/docs/media/videos"
                        class="inline-flex items-center gap-2 rounded-lg px-6 py-3 text-base font-medium text-gray-900 shadow-sm transition-colors"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14.752 11.168l-5.197-3.03A1 1 0 008 9.002v5.996a1 1 0 001.555.832l5.197-3.03a1 1 0 000-1.662z"
                            ></path>
                            <circle cx="12" cy="12" r="9" stroke-width="2"
                            ></circle>
                        </svg>
                        Video Explanations
                    </a>

                    <a
                        href="https://github.com/hikmahealth"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 shadow-sm transition-colors"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- Impact Stats -->
        <section
            class="border-b border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/30"
        >
            <div class="max-w-4xl mx-auto px-6 py-12 sm:py-16">
                <ImpactStats client:visible />
            </div>
        </section>

        <!-- Platform Pillars -->
        <section class="max-w-5xl mx-auto px-6 py-16 sm:py-20">
            <h2
                class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white text-center mb-4"
            >
                Built for the field
            </h2>
            <p
                class="text-gray-600 dark:text-gray-400 text-center max-w-xl mx-auto mb-12"
            >
                Designed for low-resource settings where internet, power, and
                infrastructure are unreliable.
            </p>
            <PlatformPillars client:visible />
        </section>

        <!-- Platform Architecture -->
        <section
            class="border-t border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/30"
        >
            <div class="max-w-5xl mx-auto px-6 py-16 sm:py-20">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white text-center mb-4"
                >
                    The platform
                </h2>
                <p
                    class="text-gray-600 dark:text-gray-400 text-center max-w-xl mx-auto mb-12"
                >
                    Three components that work together — deploy in under thirty
                    minutes.
                </p>
                <PlatformOverview client:visible />
            </div>
        </section>

        <!-- Documentation Cards -->
        <section class="max-w-5xl mx-auto px-6 py-16 sm:py-20">
            <h2
                class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white text-center mb-4"
            >
                Explore the documentation
            </h2>
            <p
                class="text-gray-600 dark:text-gray-400 text-center max-w-xl mx-auto mb-12"
            >
                Everything you need to deploy, customize, and contribute to
                Hikma Health for your organization.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <DocCard
                    title="Quick Start"
                    description="Get up and running with Hikma Health in under thirty minutes."
                    href="/docs/introduction/getting-started"
                    icon="🚀"
                />
                <DocCard
                    title="Architecture Guide"
                    description="Understand how the server, mobile app, and database fit together."
                    href="/docs/core-concepts/architecture-guide"
                    icon="🏗️"
                />
                <DocCard
                    title="Deployment"
                    description="Deploy to production with one-click buttons for Render and DigitalOcean."
                    href="/docs/deployment/quick-start"
                    icon="☁️"
                />
                <DocCard
                    title="Dynamic Forms"
                    description="Create and customize data collection forms without writing code."
                    href="/docs/core-concepts/dynamic-event-forms"
                    icon="📋"
                />
                <DocCard
                    title="Customization"
                    description="Tailor the platform to your organization's specific needs."
                    href="/docs/customization/customization-options"
                    icon="🔧"
                />
                <DocCard
                    title="Contributing"
                    description="Help improve Hikma Health for communities around the world."
                    href="/docs/contributing/how-to-contribute"
                    icon="🤝"
                />
            </div>
        </section>

        <!-- Bottom CTA -->
        <section
            class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50"
        >
            <div class="max-w-3xl mx-auto px-6 py-16 text-center">
                <p
                    class="text-sm font-medium text-hikma-600 dark:text-hikma-400 mb-2"
                >
                    Open source
                </p>
                <h2
                    class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4"
                >
                    Built for the communities that need it most
                </h2>
                <p
                    class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto mb-8 leading-relaxed"
                >
                    Hikma Health is free, open source, and committed to being a
                    digital public good. We believe the best way to build a
                    better future is to share our work with the world.
                </p>
                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-4"
                >
                    <a
                        href="/docs/introduction/getting-started"
                        class="inline-flex items-center gap-2 rounded-lg bg-hikma-600 hover:bg-hikma-700 px-5 py-2.5 text-sm font-medium text-white transition-colors"
                    >
                        Read the docs
                    </a>
                    <a
                        href="https://hikmahealth.org"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
                    >
                        Visit hikmahealth.org
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-gray-800 py-8 px-6">
        <div
            class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400"
        >
            <p>
                &copy; {new Date().getFullYear()} Hikma Health. All rights reserved.
            </p>
            <div class="flex items-center gap-6">
                <a
                    href="https://hikmahealth.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                    >Website</a
                >
                <a
                    href="https://github.com/hikmahealth"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                    >GitHub</a
                >
                <a
                    href="mailto:tech@hikmahealth.org"
                    class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                    >Contact</a
                >
            </div>
        </div>
    </footer>
</Layout>

<script>
    function initHomePage() {
        // Mobile sidebar toggle
        const toggle = document.getElementById("mobile-menu-toggle");
        const overlay = document.getElementById("mobile-sidebar-overlay");
        const closeBtn = document.getElementById("mobile-sidebar-close");

        function openSidebar() {
            overlay?.classList.remove("hidden");
            overlay?.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }

        function closeSidebar() {
            overlay?.classList.add("hidden");
            overlay?.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        }

        toggle?.addEventListener("click", openSidebar);
        closeBtn?.addEventListener("click", closeSidebar);
        overlay?.addEventListener("click", (e) => {
            if (e.target === overlay) closeSidebar();
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !overlay?.classList.contains("hidden")) {
                closeSidebar();
            }
        });

        // Theme toggle
        const themeToggle = document.getElementById("theme-toggle");
        themeToggle?.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
    }

    initHomePage();
    document.addEventListener("astro:after-swap", initHomePage);
</script>
